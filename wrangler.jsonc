{
  "name": "flight-monitor",
  "account_id": "43f63f431e7bd5060ca95cd870e1323d",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./public" },
  "triggers": {
    // 每天查一次 (UTC 0:00 = 北京时间 8:00，早上起来看结果)
    "crons": ["0 0 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flight-monitor-db",
      "database_id": "6f2d03e7-7ead-444d-89ed-76b1a4b7ce83"
    }
  ],
  // TELEGRAM_BOT_TOKEN, SERPAPI_KEY, RAPIDAPI_KEY 存为 wrangler secrets，不放 vars
  "vars": {
    "NOTIFY_EMAIL": "zhangyuanbo123@gmail.com",
    "EMAIL_FROM": "noreply@aicatalog.io"
  }
}
